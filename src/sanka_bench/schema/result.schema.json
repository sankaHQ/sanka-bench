{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sanka.com/schemas/sanka-bench/result/v0.1.json",
  "title": "Sanka Migration Bench result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "candidate_id",
    "status",
    "fully_migrated",
    "hard_gates",
    "metrics",
    "scenarios",
    "provenance",
    "errors"
  ],
  "properties": {
    "schema_version": { "const": "sanka-bench/result/v0.1" },
    "task_id": { "type": "string" },
    "candidate_id": { "type": "string" },
    "status": { "enum": ["passed", "failed", "invalid"] },
    "fully_migrated": { "type": "boolean" },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_qualified",
        "regression_tests",
        "target_boot",
        "native_target",
        "behavior_parity",
        "database_parity",
        "side_effect_parity",
        "deterministic"
      ],
      "properties": {
        "source_qualified": { "type": "boolean" },
        "regression_tests": { "type": "boolean" },
        "target_boot": { "type": "boolean" },
        "native_target": { "type": "boolean" },
        "behavior_parity": { "type": "boolean" },
        "database_parity": { "type": "boolean" },
        "side_effect_parity": { "type": "boolean" },
        "deterministic": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_count",
        "route_coverage",
        "behavioral_parity",
        "database_parity",
        "side_effect_parity"
      ],
      "properties": {
        "scenario_count": { "type": "integer", "minimum": 0 },
        "route_coverage": { "$ref": "#/$defs/fraction" },
        "behavioral_parity": { "$ref": "#/$defs/fraction" },
        "database_parity": { "$ref": "#/$defs/fraction" },
        "side_effect_parity": { "$ref": "#/$defs/fraction" }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target_ran",
          "behavior_match",
          "database_match",
          "side_effect_match",
          "stable",
          "detail"
        ],
        "properties": {
          "id": { "type": "string" },
          "target_ran": { "type": "boolean" },
          "behavior_match": { "type": "boolean" },
          "database_match": { "type": "boolean" },
          "side_effect_match": { "type": "boolean" },
          "stable": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_digest",
        "source_digest",
        "candidate_digest",
        "evaluator_version",
        "repeat"
      ],
      "properties": {
        "task_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "candidate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "evaluator_version": { "type": "string" },
        "repeat": { "type": "integer", "minimum": 2 }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "total", "rate"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
